# All variables here are NEXT_PUBLIC_* and are inlined at build time — none are secret.
# Real values live in .env.local (gitignored) and must also be set as GitHub Actions
# variables, since next build runs in CI, not on the droplet. See docs/08-deploy-digitalocean.md.

NEXT_PUBLIC_SITE_URL=https://twinfallsroofers.com
NEXT_PUBLIC_GTM_ID=
# Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz (notifications go to ccstwinfalls@gmail.com).
# Empty: form shows a dev-only preview locally and a phone fallback in production.
NEXT_PUBLIC_FORM_ENDPOINT=
